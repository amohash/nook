# Copy values into the ignored mobile environment file in your actual app.
# All EXPO_PUBLIC values are visible in the client bundle.
EXPO_PUBLIC_API_BASE_URL=https://YOUR_DEPLOYED_API_HOST
EXPO_PUBLIC_DEFAULT_DATA_MODE=demo
# Only required if optional direct Supabase Auth is implemented.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
