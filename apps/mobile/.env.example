# All EXPO_PUBLIC values are public and bundled into the app. Never add provider secrets here.
# fixture works without a backend. api uses the same demo dataset over HTTP for now.
EXPO_PUBLIC_DATA_PROVIDER=fixture
# On a phone, replace localhost with the laptop LAN IP, or use the deployed HTTPS API URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
# Austin discovery requires the configured backend; guest access starts automatically.
# For cellular/Expo tunnel use a public HTTPS API URL, not localhost/LAN.
EXPO_PUBLIC_NEARBY_ENABLED=1
EXPO_PUBLIC_ASSISTANT_ENABLED=0
# Social accounts (P1, off by default). On only when the flag is 1 AND both values are set.
# Use the nook-social project's anon/publishable key. NEVER a service-role or secret key: it would ship in the app.
EXPO_PUBLIC_SOCIAL_ENABLED=0
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
