{
  "name": "space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "server",
    "packages/*",
    "fixtures"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "concurrently -k -n api,mobile \"npm run dev:server\" \"npm run dev:mobile\"",
    "dev:mobile": "npm run dev --workspace @space/mobile --",
    "dev:server": "npm run dev --workspace @space/server",
    "dev:web": "npm run web --workspace @space/mobile --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run build:server",
    "build:server": "npm run build --workspace @space/server",
    "start:server": "npm run start --workspace @space/server",
    "export:mobile": "npm run export --workspace @space/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "react": "19.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.5"
  }
}
