{
  "name": "@space/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --external:express --external:cors --external:dotenv --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@space/contracts": "*",
    "@space/core": "*",
    "@space/fixtures": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": { "@types/cors": "^2.8.19", "@types/express": "^5.0.5" }
}
