# Server only; loaded from server/.env by dev and start scripts.
PORT=3001
COMMIT_SHA=development
# Optional normalized snapshot path, relative to server/. Unset serves labeled demo data.
DATASET_PATH=
# Server/operator only. Public API routes never call SerpApi.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SERPAPI_API_KEY=
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
ENABLE_CITY_BUILD=false
