# Server only; loaded from server/.env by dev and start scripts.
PORT=3001
COMMIT_SHA=development
# Optional normalized snapshot path, relative to server/. Unset serves labeled demo data.
DATASET_PATH=
# Server only. Session-gated nearby routes may call SerpApi within the configured budget.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SERPAPI_API_KEY=
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
ENABLE_CITY_BUILD=false
# Runtime discovery; app access uses automatic guest sessions.
# Optional legacy operator access code remains server-only.
NEARBY_ENABLED=0
NEARBY_TESTER_ACCESS_CODE=
NEARBY_ACCOUNT_BUDGET_KEY=austin-runtime-20261025
# Default 18; explicitly approved demo runtime ceiling may be raised up to 250.
# The first 18 slots remain reserved for the legacy ledger. No automatic reset.
NEARBY_ACCOUNT_REQUEST_LIMIT=18
